# Cutroom environment. Copy to .env for local development.
# The same variables go into Vercel (web) and Render (worker) in production.
# Every variable is explained in docs/ENVIRONMENT.md.

# --- Both web app and worker -----------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: the voice model for AI voice-overs (free tier).
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Optional: the picture model. Image models need billing on the key's Google Cloud project.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# GEMINI_IMAGE_SIZE=2K
# Optional, paid: ElevenLabs voices with exact word timing.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Shared secret between the web app and the worker. Any long random string.
WORKER_SECRET=change-me
# Google OAuth client (Google Cloud console > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production only: Vercel Blob read-write token. Leave empty locally to store files in .data/storage.
BLOB_READ_WRITE_TOKEN=

# --- Web app -----------------------------------------------------------------
# Where the worker runs. Locally: http://localhost:8787
WORKER_URL=http://localhost:8787
# Production only: Neon connection string. Leave empty locally to use the embedded database in .data/pglite.
DATABASE_URL=
# Set a password before deploying. Leave empty locally to skip the login page.
APP_PASSWORD=
# Optional: signs login sessions. Defaults to a value derived from APP_PASSWORD.
SESSION_SECRET=
# Protects /api/cron. Vercel sends it automatically when set. Required in production:
# with APP_PASSWORD set and no CRON_SECRET, the daily check refuses to run.
CRON_SECRET=
# Optional: run the worker on GitHub Actions instead of WORKER_URL (see DEPLOYMENT.md).
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPO=your-name/Cutroom
# GITHUB_WORKFLOW_FILE=worker.yml
# GITHUB_BRANCH=main
# Optional: set to render to keep using WORKER_URL while the GitHub variables above are set.
# WORKER_MODE=
# Optional: messages when a video needs you, fails or goes out. Set any of these.
# NOTIFY_DISCORD_WEBHOOK_URL=
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
# RESEND_API_KEY=
# NOTIFY_EMAIL_TO=
# NOTIFY_EMAIL_FROM=Cutroom <onboarding@resend.dev>

# --- Worker ------------------------------------------------------------------
# Public URL of the web app, so the worker can reach it. Locally: http://localhost:3000
APP_URL=http://localhost:3000
# Optional: ffmpeg binary paths and thread count.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# FFMPEG_THREADS=
# Optional: the worker's own public address, so it can keep itself awake while a job runs.
# Render sets RENDER_EXTERNAL_URL automatically; set this on other hosts that sleep.
# WORKER_PUBLIC_URL=
